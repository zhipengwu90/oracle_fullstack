# Root env file for docker-compose (docker compose auto-loads ".env" next
# to the compose file). Copy to ".env" and fill in real values before
# running `docker compose up`. This file lives ONLY on each machine, never
# in git.

# --- Django backend ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# "backend" is required so the frontend container's server-side fetch to
# http://backend:8000 passes Django's host check. Add your real domain too.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,app.wuapp.app
DJANGO_CORS_ALLOWED_ORIGINS=https://app.wuapp.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.wuapp.app

# --- PostgreSQL running directly on the Oracle host (NOT in Docker) ---
# host.docker.internal is mapped to the host gateway via extra_hosts in
# docker-compose.yml, so containers can reach Postgres on the host.
DB_NAME=myapp
DB_USER=wuz
DB_PASSWORD=change-me
DB_HOST=host.docker.internal
DB_PORT=5432
DB_SCHEMA=my_bank
