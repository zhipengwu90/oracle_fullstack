# Root env file for docker-compose (docker compose auto-loads ".env" next
# to the compose file). Copy to ".env" and fill in real values before
# running `docker compose up` — especially on the Oracle VM.

# --- Django backend ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# Add your domain / Oracle VM public IP here, comma-separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,your-domain-or-ip
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost,http://your-domain-or-ip
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://your-domain-or-ip

# --- PostgreSQL running directly on the Oracle host (NOT in Docker) ---
# host.docker.internal is mapped to the host gateway via extra_hosts in
# docker-compose.yml, so containers can reach Postgres on the host.
DB_NAME=myapp
DB_USER=wuz
DB_PASSWORD=change-me
DB_HOST=host.docker.internal
DB_PORT=5432
DB_SCHEMA=public
