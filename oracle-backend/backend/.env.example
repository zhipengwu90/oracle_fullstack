# Copy this file to backend/.env for local development.
# In Docker/production, set these as real environment variables in
# docker-compose.yml / an env_file instead of shipping .env in the image.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL running directly on the Oracle Cloud host.
# Use "localhost" here when running manage.py on the host,
# and "host.docker.internal" when the backend runs inside Docker.
DB_NAME=myappdb
DB_USER=myappuser
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# First schema in the connection's search_path (Django's own auth/admin/
# session tables stay found via the "public" fallback). Leave as "public"
# if you don't need a separate schema for your app's own data.
DB_SCHEMA=public

DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
